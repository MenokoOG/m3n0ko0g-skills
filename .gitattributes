# Catch-all first, so the specific rules below override it. Git leaves files
# that are already CRLF in the index alone under text=auto, so this does not
# rewrite the existing fixtures.
* text=auto eol=lf

# .skill bundles are zip archives. Never let line-ending conversion near them.
*.skill binary
*.zip binary

# Everything the packager reads is normalized to LF on the way in, so keep the
# working tree matching. Otherwise a Windows checkout re-zips to different bytes
# than a Linux one and --check fails on whichever machine did not build last.
*.SKILL.md text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
